+/**
+ * ENG-019 · Da por vencida la reserva de los envíos abiertos de una factura, como si el despacho
+ * que los tomó se hubiera colgado más de `RESERVA_DEL_ENVIO_SEGUNDOS`. Es la única forma en que un
+ * segundo despacho toma un envío que otro tiene: los tests de "despacho viejo" la necesitan.
+ */
+async function vencerReservas(p: NonNullable<Awaited<ReturnType<typeof preparar>>>, invoiceId: string) {
+  for (const e of await p.envios(invoiceId)) {
+    await p.operatorPrisma.$executeRaw`
+      UPDATE "OutboxEvent"
+      SET "payload" = jsonb_set("payload", '{reserva,hasta}', to_jsonb(now() - interval '1 second'))
+      WHERE "id" = ${e.id} AND "payload" ? 'reserva'`;
+  }
+}
