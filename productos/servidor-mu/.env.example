# Copiá este archivo a .env y cambiá TODO lo que dice CAMBIAME.
#   cp .env.example .env
# El .env está en .gitignore: nunca se commitea.
#
# Passwords: largos, solo letras, números, - y _. Sin espacios, sin #, sin $,
# sin comillas — esos caracteres rompen el parseo del .env y los scripts te van
# a frenar con un error claro antes que dejarte debuggear un login fantasma.

# ── Base de datos ────────────────────────────────────────────────────────────
DB_ADMIN_USER=postgres
DB_ADMIN_PW=CAMBIAME_password_largo_de_la_db

# ── Panel de administración ──────────────────────────────────────────────────
# Se siembra en el PRIMER arranque. Si no lo definís, el panel arranca sin login.
OPENMU_ADMIN_USER=admin
OPENMU_ADMIN_PASSWORD=CAMBIAME_password_largo_del_panel

# Dónde escucha el panel. 127.0.0.1 = solo esta máquina (default sano).
# Para entrar desde otra máquina, NO lo abras a 0.0.0.0: usá Tailscale
# (ver docs/04-operacion.md → "Entrar al panel desde afuera").
PANEL_BIND_ADDR=127.0.0.1
PANEL_PORT=8080

# ── Puertos del juego ────────────────────────────────────────────────────────
# 0.0.0.0 = lo ve tu LAN (y tu router, si hacés port forwarding).
# 127.0.0.1 = solo esta máquina, útil para probar solo.
BIND_ADDR=0.0.0.0

# ── Qué IP anuncia el server a los clientes ──────────────────────────────────
# El connect server le dice al cliente "el game server está en tal IP". Si esa
# IP está mal, el cliente lista los servers pero no puede entrar a jugar.
#   local            = tu IP de LAN (default acá; para jugar en casa)
#   public           = tu IP pública (solo si abriste puertos en el router)
#   una IP concreta  = para Tailscale poné tu IP 100.x.x.x
# Si la variable no hiciera efecto en tu versión de la imagen, el mismo ajuste está
# en el panel: Configuration → System → IP Resolver (esa es la vía oficial).
# Detalle en docs/04-operacion.md → "La IP que anuncia el server".
RESOLVE_IP=local

# ── Versión de la imagen ─────────────────────────────────────────────────────
# 'latest' sigue el master de OpenMU. Cuando tengas el server andando y con
# gente adentro, pineá un tag/digest concreto para que un pull no te cambie el
# server abajo de los pies.
OPENMU_TAG=latest
