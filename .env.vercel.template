# ============================================================================
# Plantilla de variables de entorno para VERCEL (proyecto erp-ch, Hobby)
# ----------------------------------------------------------------------------
# SOLO NOMBRES + para qué sirve cada una. NO tiene valores secretos.
# Uso: completá los valores y pegá/importá en Vercel → Settings → Environment
# Variables (ambiente Production). Los valores de DB/secretos son los MISMOS que
# ya usás en prod (Neon) — no inventes.
#
# Regla: NO commitees este archivo con valores. Los secretos van SOLO en Vercel.
# ============================================================================

# ── OBLIGATORIAS (sin estas la app no arranca sana) ─────────────────────────

# Conexión principal a Neon con el rol de la app (app_rls cuando RLS está ON).
DATABASE_URL=

# Conexión a Neon con el rol DIRECTO (sin pooler) que usa el BUILD para migrar.
#
# Sólo en el entorno Production, y sólo si querés que el deploy aplique las migraciones
# pendientes. Sin esta variable el build compila y no toca ninguna base — que es el
# comportamiento de siempre y el default seguro.
#
# ⚠️ TIENE QUE SER LA DIRECTA. Es la misma cadena SIN "-pooler" en el host: en Neon,
# Connection string → destildar "Connection pooling". El pooler RECHAZA las migraciones, y
# el build frena solo si detecta que le pasaron la del pooler.
#
# ⚠️ ANTES DE PUBLICAR CON ESTO PUESTO: hacé el respaldo. Un branch de Neon (un clic en la
# consola) o un pg_dump. Ningún script puede decidir por vos que no hace falta.
#
# Qué hace el build cuando está seteada (scripts/vercel-build.mjs, en este orden):
#   1. muestra el estado de la base   2. `prisma migrate deploy`
#   3. verifica que los índices únicos de idempotencia EXISTAN — si falta uno, NO publica
#   4. audita el aislamiento entre negocios (avisa, no frena)   5. compila
# Cualquier fallo de 2 o 3 deja el código viejo sirviendo, intacto.
MIGRATE_DATABASE_URL=

# Conexión a Neon con el rol OWNER (neondb_owner) para el control-plane /operador
# (cross-tenant). Si falta, cae a DATABASE_URL (app_rls) y el operador queda
# bloqueado por RLS. Setear SIEMPRE en prod multi-tenant.
OPERATOR_DATABASE_URL=

# Secreto HMAC que firma la cookie de sesión del panel del tenant (/admin).
AUTH_SECRET=

# Secreto HMAC de la cookie del operador (/operador) — llavero SEPARADO del tenant.
# Rotarlo es la forma de CORTAR todas las sesiones de operador abiertas (hay que volver a entrar).
OPERATOR_SECRET=

# Contraseña de la consola de operador (/operador/login). Obligatoria en prod.
# NOTA: el código usa OPERATOR_PASSWORD, NO "ADMIN_PASSWORD" (esa no la lee nadie).
# Es la clave del operador DUEÑO: entra con el nombre vacío o con OPERADOR_DUENIO. No puede estar
# vacía ni ser sólo espacios (el build de producción frena y el login la rechaza).
# OJO: cambiar esta clave NO corta las sesiones ya abiertas (el token firmado no la lleva y vale
# hasta 8 h). Si se filtró, rotá también OPERATOR_SECRET: eso sí las invalida a todas.
OPERATOR_PASSWORD=

# OPCIONAL. Nombre del operador dueño (el único que puede cambiar algo en CH). Sin esto: "duenio".
# Minúsculas, números, - y _ (se normaliza: "Tomás" → "tomas"). Ser dueño depende de CÓMO se entró
# (con OPERATOR_PASSWORD; va firmado en la sesión), no sólo del nombre. Cambiarlo cierra la sesión
# abierta del dueño y la de un operador de OPERADORES que tenga ese nombre (su línea deja de valer:
# el nombre del dueño está reservado); las de los demás operadores siguen.
OPERADOR_DUENIO=

# OPCIONAL. Otros operadores con nombre: "nombre=pbkdf2$sal$hash;otro=pbkdf2$sal$hash".
# Cada persona arma su línea en /operador/clave (la clave no sale de su navegador). Sacar a alguien
# de acá le corta la sesión en el próximo pedido; cambiarle la línea (otra clave) NO la corta:
# para eso, rotar OPERATOR_SECRET. Vacía = sólo el dueño.
OPERADORES=

# Activa el candado RLS de Postgres (aislamiento por fila). Poner exactamente: on
RLS_ENFORCEMENT=on

# ── RUTEO POR TENANT ────────────────────────────────────────────────────────

# Mapa EXACTO hostname → subdomain del tenant, para URLs .vercel.app GRATIS
# (sin dominio propio). Formato: "host1=sub1;host2=sub2". Se resuelve ANTES que
# el subdominio de APP_BASE_DOMAIN. Valor para este deploy:
#   TENANT_HOST_MAP=chestetica-erp.vercel.app=chestetica;magra-erp.vercel.app=magra;shinevelas-erp.vercel.app=shinevelas;adosmanos-erp.vercel.app=adosmanos
TENANT_HOST_MAP=

# Dominio base para routing por SUBDOMINIO (dominio propio: <sub>.APP_BASE_DOMAIN).
# ⚠️ En el deploy .vercel.app SIN dominio propio: DEJAR VACÍO / NO SETEAR.
#    (Poner "vercel.app" acá rompería: trataría "chestetica-erp" como subdominio.)
# APP_BASE_DOMAIN=

# ── RECOMENDADA ─────────────────────────────────────────────────────────────

# Protege /api/cron/reminders. Vercel Cron inyecta el Bearer automáticamente
# cuando esta var existe. Sin ella el endpoint queda abierto (fail-open).
CRON_SECRET=

# ── OPCIONALES (encienden features; sin ellas la feature queda inerte) ───────

# Firma de webhooks de Mercado Pago (HMAC). Necesaria SOLO al activar cobros MP
# reales (con invoicing ON, sin ella el webhook responde 503 fail-closed).
MP_WEBHOOK_SECRET=

# Envío de emails (recordatorios/notificaciones) vía Resend. Sin key → modo simulado.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# API pública de ingesta de pedidos externos (WordPress/Woo). Una clave única, o
# la variante multi-tenant JSON {"<slug>":"<key>"} en EXTERNAL_ORDERS_API_KEYS.
EXTERNAL_ORDERS_API_KEY=
EXTERNAL_ORDERS_API_KEYS=

# Flag de facturación electrónica ARCA (off por default; requiere cert + homologación).
ARCA_INVOICING_ENABLED=

# ── NO SETEAR EN ESTE DEPLOY ────────────────────────────────────────────────
# FORCE_TENANT_SLUG → fijaría TODO el proyecto a un solo tenant (Opción A) y
#   rompería el multi-tenant por host/subdominio. Solo para un preview de 1 tenant.
# ADMIN_PASSWORD → legacy, el runtime NO la lee. No hace falta.
#
# ── LAS PROVEE VERCEL SOLA — NO cargar ──────────────────────────────────────
# VERCEL_GIT_COMMIT_SHA (commit del deploy, lo lee /api/health) · NODE_ENV=production

# ── FLAGS DE PRODUCTO (todos DEFAULT OFF) ───────────────────────────────────
#
# Agregados 2026-09-17: no estaban documentados y nadie sabía qué valor tenían.
# Se anexan AL FINAL a propósito, para no correr los números de línea de arriba
# (src/lib/rls.ts y src/lib/tenant.ts citan líneas de este archivo).
#
# CÓMO SE PRENDEN: el parser acepta `1` / `true` / `on` / `yes` (case-insensitive,
# con trim). CUALQUIER otro valor —incluido no setear la variable— es OFF
# (`truthy()`, src/modules/flags.ts:82-86).
#
# 🚨 LOS CUATRO PRIMEROS SON GLOBALES DEL DEPLOY, NO POR TENANT. Los cuatro
#    tenants comparten el mismo proyecto de Vercel y la misma base: prender uno
#    de estos flags para probar algo en un tenant lo prende para TODOS. Antes de
#    tocarlos, pensá qué le pasa a `beauty-spa`, que es el único vivo.
#
#    El eje de gating que SÍ se usa hoy no es ninguno de estos: es el RUBRO
#    (`Tenant.blueprintId` → isRetail/carniceriaOnly, src/lib/carniceria/rubro.ts:26-37),
#    que es dato POR TENANT y no necesita flags.

# Registro de módulos ENFORCED (ADR-054/055). Default OFF (src/modules/flags.ts:13-18).
# ON = el menú del backoffice se arma SÓLO con `Tenant.modules[]`
#      (src/lib/module-gating.ts:27-43); apagar un módulo lo saca del menú.
# ⛔ NO PRENDER. `beauty-spa` tiene `modules = {}` y `blueprintId = NULL`: el resolver
#    parte de lo asignado y sólo RESTA (src/modules/activation.ts:12-16,77), así que su
#    set de activos queda VACÍO y el único cliente vivo se queda SIN MENÚ.
#    Comprobalo: SELECT slug, modules, "blueprintId" FROM "Tenant" WHERE slug='beauty-spa';
# MODULE_REGISTRY_ENABLED=

# Motor de perfiles Comercio(lite)/Empresa(enterprise) (ADR-058/059). Default OFF
# (src/modules/flags.ts:31-35). OFF = `getActiveProfile` devuelve null y no se gatea
# por perfil. ON = se lee `Tenant.profile` y la nav se filtra por perfil.
# ⚠️ Cross-tenant: los 4 tenants nacen `lite` (default de la columna), así que prenderlo
#    esconde de golpe todo lo marcado `enterprise-only` en los 4.
# PROFILES_ENABLED=

# Navegación agrupada de PR-2 (5 grupos + densidad + primitivos). Default OFF
# (src/modules/flags.ts:65-69). Es el interruptor MAESTRO de esa interfaz: OFF deja la
# nav plana legada sin tocar un pixel.
# ⚠️ Cross-tenant: cambia el menú de los 4 tenants a la vez, incluido `beauty-spa`.
# NAV_GROUPING_ENABLED=

# Candado/teaser de ítems `enterprise-only` en un tenant `lite`. Default OFF
# (src/modules/flags.ts:76-80). Sólo tiene efecto con NAV_GROUPING_ENABLED y
# PROFILES_ENABLED ambos ON. Default OFF por regla de producto: sembrar candados en la
# nav del micro es decirle "estás en el plan barato". Opt-in de venta, nunca default.
# UPGRADE_TEASER_ENABLED=

# Ficha de marca por tenant: la piel sale de los DATOS del Tenant (accentPreset/
# frontTheme/blueprintId/name) + theme pack, en vez del mapa hardcodeado por slug.
# Default OFF (src/lib/identity.ts:63-68). Con OFF el branding es byte-idéntico al de
# hoy y `beauty-spa` no se toca.
# ⚠️ Cross-tenant, pero es el ÚNICO de esta lista cuyo encendido MEJORA a los tenants
#    que no están en el mapa por slug (hoy caen a la piel de CH). Sigue OFF hasta
#    verificar `beauty-spa` con él prendido en un preview.
# TENANT_BRAND_SHEET_ENABLED=

# NOTA — `RLS_ENFORCEMENT` ya está documentada arriba (sección OBLIGATORIAS) y va en
# `on`. No es un flag de producto: es el candado de aislamiento por fila. Se lee con
# comparación EXACTA a la cadena "on" (src/lib/prisma-base.ts:47) — `1`/`true`/`yes`
# NO la activan, a diferencia de los flags de arriba. Escribí exactamente: on

# ── QUÉ NO ESTÁ MEDIDO ──────────────────────────────────────────────────────
# Esta plantilla lista NOMBRES y DEFAULTS del código, no el estado real del deploy.
# Para saber qué está seteado hoy en Production:
#   vercel env ls production
#   vercel env pull .env.produccion.local   # y leerlo; NO commitearlo

# ── TENANT_HOST_MAP CON 5 LOCALES: EDITARLA ES UN PROCEDIMIENTO ─────────────
#
# POR QUÉ esto merece un procedimiento y no una línea: `TENANT_HOST_MAP` NO es una
# variable por tenant. Es UNA sola cadena concatenada con `;` (ver arriba, línea 41)
# que contiene el ruteo de TODOS los tenants. Editarla a mano en el cuadrito de Vercel
# es la forma más fácil de borrar el ruteo de `beauty-spa` sin darte cuenta.
#
# Y no te vas a enterar al guardar: el parser DESCARTA EN SILENCIO cualquier entrada
# malformada (`if (eq <= 0) continue;`, src/lib/tenant.ts:80). No hay error de arranque
# ni warning. El tenant afectado se cae recién cuando alguien entra:
#   · entrada PERDIDA/malformada  → src/lib/tenant.ts:150-154
#       "hay más de un tenant y el request no trae subdominio para resolver"
#   · entrada presente pero apuntando a un subdomain que ningún tenant tiene
#                                 → src/lib/tenant.ts:130-135
#       "no hay tenant para el subdominio «X» (vía TENANT_HOST_MAP)"
# Los dos son fail-closed a propósito (ADR-015): antes que servirle a un local el dato
# de otro, la app se niega a responder. No se "arregla" aflojando el throw.
#
# PROCEDIMIENTO para dar de alta los 5 locales de MAGRA (las 5 entradas en UNA edición):
#   1. Copiar el valor ACTUAL a un editor de texto. No editar dentro de Vercel.
#   2. Pegar las 5 entradas nuevas al final, separadas por `;`, sin tocar las viejas.
#   3. CONTAR antes de guardar — tiene que dar (viejas + 5):
#        echo "<valor nuevo>" | tr ';' '\n' | grep -c '='
#      y que ninguna vieja se haya caído (tiene que dar 1):
#        echo "<valor nuevo>" | tr ';' '\n' | grep -c 'chestetica-erp.vercel.app=chestetica'
#   4. Guardar + redeploy (la var se lee en runtime, pero Vercel la propaga al deployar).
#   5. Abrir los 5 hosts nuevos Y el de `beauty-spa`, y confirmar en cada /admin que el
#      NOMBRE DEL NEGOCIO en pantalla es el correcto. Que cargue no alcanza.
#
# El lado izquierdo es el hostname; el DERECHO es `Tenant.subdomain` (NO el slug): es la
# columna que consulta src/lib/tenant.ts:125-129. Suelen coincidir porque los elegimos
# iguales; si no coinciden, gana `subdomain`.
#
# Paso a paso completo del alta de cada local: docs/runbooks/alta-magra.md

# ── CUENTAS CORRIENTES → LIBRO DE CAJA (default OFF) ────────────────────────
#
# Agregado en la integración de la ola 2 (se anexa AL FINAL para no correr las líneas
# que citan src/lib/rls.ts, src/lib/tenant.ts y src/lib/docs-verificadas.test.ts).
#
# ON = el cobro de una cuenta a cobrar (fiado), el pago de una cuenta a pagar y el cheque
#      acreditado además ASIENTAN su ingreso/egreso en el libro de caja, en la misma
#      transacción, con la marca `cuenta-corriente:<collectionId>` y frenados si hoy ya
#      está cerrado (src/lib/settlement/asiento-libro.ts). OFF = graban el cobro/pago y
#      nada en el libro, como siempre.
# Se lee con `cuentasCorrientesEnabled()` (asiento-libro.ts): `1`/`true`/`on`/`yes`.
# ⚠️ Global del deploy (los 4 tenants a la vez, `beauty-spa` incluido).
# ⛔ NO PRENDER hasta que se cumplan LAS DOS cosas:
#    1. `npm run medir:neon` muestra aplicado el lote de 5 migraciones de caja (entre
#       ellas la que agrega `CashMovement.collectionId`): sin esa columna el asiento falla
#       y con él el cobro. Aplicarlas en Neon es decisión del dueño.
#    2. Están en el código las tres guardas del libro (integración ola 2): el libro no deja
#       borrar una fila `cuenta-corriente:` (`motivoParaNoBorrar`, src/lib/caja/libro-caja.ts),
#       el libro la clasifica como "Cobro de cuenta corriente" / "Pago a proveedor" y no como
#       ingreso/egreso manual (`marcasDelSistema`, mismo archivo), y el formulario de cobro
#       no trae un medio por defecto (src/components/cuentas/RegisterCollectionForm.tsx).
# CUENTAS_CORRIENTES_ENABLED=
